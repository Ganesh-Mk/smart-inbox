# Smart Inbox — production environment. Copy to `.env` ON THE SERVER and fill in every
# REPLACE_ME. This file is committed; `.env` is gitignored and must never be committed
# (CLAUDE.md constraint 3).
#
# Generate the passwords rather than inventing them:
#   openssl rand -base64 24 | tr -d '/+=' | head -c 24

# ---- Public address ----
# The domain Caddy will obtain a Let's Encrypt certificate for. Must already resolve to this
# VM's public IP before the stack is started, or certificate issuance fails.
SITE_ADDRESS=smart-inbox.duckdns.org

# ---- AI ----
# Only model permitted: anthropic/claude-haiku-4.5
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=anthropic/claude-haiku-4.5

# ---- Oracle ----
# ORACLE_HOST/PORT are set by docker-compose.prod.yml to the compose service name; they are
# deliberately absent here.
ORACLE_PASSWORD=REPLACE_ME
ORACLE_SERVICE=FREEPDB1
ORACLE_APP_USER=SMARTINBOX
ORACLE_APP_PASSWORD=REPLACE_ME

# ---- Mailbox ----
# GreenMail, internal to the VM. To demo against a real Gmail account instead, point
# MAIL_HOST/PORT/USER/PASSWORD at it and set MAIL_SSL=true — the ingestion code is unchanged.
MAIL_USER=safety@smart-inbox.test
MAIL_PASSWORD=REPLACE_ME
MAIL_SSL=false
MAIL_FOLDER=INBOX

# ---- Reviewer UI logins ----
# The demo defaults (reviewer/reviewer, admin/admin) are fine on localhost and are NOT fine on
# a public URL. These have no defaults on purpose — the stack refuses to start without them.
REVIEWER_USER=reviewer
REVIEWER_PASSWORD=REPLACE_ME
ADMIN_USER=admin
ADMIN_PASSWORD=REPLACE_ME

# ---- Limits ----
MAX_ATTACHMENT_MB=25
MAX_PDF_PAGES=60
WORKER_THREADS=4
